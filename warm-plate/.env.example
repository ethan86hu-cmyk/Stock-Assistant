# Copy this file to .env and fill in one provider.
# With no key set, the app runs in demo mode.

# --- DeepSeek (default when DEEPSEEK_API_KEY is set) ---
DEEPSEEK_API_KEY=
# The vision model is experimental; override if DeepSeek renames it.
# AI_MODEL=deepseek-v4-flash-vision-exp

# --- Any other OpenAI-compatible API (Qwen-VL, OpenAI, a local server...) ---
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-vl-max
# AI_API_KEY=
# Set to 0 if the server rejects response_format.
# AI_JSON_MODE=1

# --- Claude ---
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# PORT=3000
